.env
__pycache__/
*.pyc
venv/
.venv/
data/*
!static/data/
!data/consensus.yaml
!data/datacenter_markets.csv
!data/datacenter_facilities.csv
!data/datacenter_abs_deals.csv
!data/dc_private_credit.csv
!data/dc_private_credit_operators.csv
!data/agency_ratings.csv
!data/agency_ratings_history.csv
!data/sovereign_defaults.csv
!data/banking_crises.csv
!data/imf_programs.csv
!data/fx_debt_share.csv
!data/sovereign_bond_yields.csv
!data/structural_risk_overlay.csv

# GH Actions refresh_cache workflow commits pre-computed model outputs
# here so Flask cold-boots with warm caches. Layout matches _cache.py:
# data/cache/<namespace>_cache/<key>.json
!data/cache/
!data/cache/**
# Track only the hot-path fit-state (h1) so the deployed dashboard has
# something to load on cold boot. Everything else (h3, h5, onset,
# quarterly bundles, and any horizon-3/5/onset pickles) is regenerated
# by scripts/fit_credit_default.py and stored on the Render persistent
# disk under Config.DATA_DIR — no need to bloat the repo with 3+ MB of
# runtime pickles.
!data/credit_default_fit/
data/credit_default_fit/*
!data/credit_default_fit/fit_state_h1.json
!data/credit_default_fit/fit_model_h1.pkl

# Commodity model cache artifacts (regenerated on monthly refit)
backend/cache/commodity_models/*.pkl
backend/cache/commodity_models/*.json
